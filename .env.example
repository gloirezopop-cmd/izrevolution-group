# -------------------------------------------------------------
# CONFIGURATION SUPABASE - RÉVOLUTION GROUP
# -------------------------------------------------------------
# Ces clés se trouvent dans le tableau de bord Supabase :
# Project Settings > API

# L'URL de votre projet Supabase
VITE_SUPABASE_URL=https://votre-projet-id.supabase.co

# La clé PUBLIQUE (anon/public) utilisée par le client web.
# NE JAMAIS METTRE LA CLÉ SECRÈTE (service_role) ICI !
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
